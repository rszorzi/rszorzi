# Database
DATABASE_URL="postgresql://user:password@host:5432/kanflow"

# NextAuth
NEXTAUTH_SECRET="your-secret-32-chars-min"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth
# https://console.cloud.google.com -> Credentials -> OAuth 2.0
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub OAuth
# https://github.com/settings/developers -> OAuth Apps
GITHUB_ID=""
GITHUB_SECRET=""

# Feature Flags (set to 'true' to enable)
NEXT_PUBLIC_FEATURE_SUBSCRIPTIONS="false"
NEXT_PUBLIC_FEATURE_INTEGRATIONS="true"
